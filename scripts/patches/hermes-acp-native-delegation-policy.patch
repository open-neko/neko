+def _openneko_disabled_toolsets() -> List[str] | None:
+    """Apply OpenNeko's process-local native delegation policy to ACP."""
+    policy = os.environ.get("OPENNEKO_HERMES_NATIVE_DELEGATION", "")
+    if policy.strip().lower() == "disabled":
+        # Hermes' normal toolset subtraction removes delegate_task from the
+        # model schema and from valid_tool_names, so an undeclared direct call
+        # is rejected by the same dispatch guard as every other denied tool.
+        return ["delegation"]
+    return None
