{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "openneko.eval.result/v1"
    },
    "runId": {
      "$ref": "#/$defs/__schema0"
    },
    "slotKey": {
      "type": "string",
      "minLength": 1
    },
    "caseId": {
      "$ref": "#/$defs/__schema0"
    },
    "caseContentId": {
      "type": "string",
      "pattern": "^sha256:.*"
    },
    "family": {
      "type": "string",
      "enum": [
        "read",
        "watcher",
        "mutation",
        "resilience",
        "contract"
      ]
    },
    "productPath": {
      "$ref": "#/$defs/__schema0"
    },
    "difficulty": {
      "$ref": "#/$defs/__schema0"
    },
    "capabilityTags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "semantics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variantId": {
      "$ref": "#/$defs/__schema0"
    },
    "datasetId": {
      "$ref": "#/$defs/__schema0"
    },
    "repetition": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "phase": {
      "$ref": "#/$defs/__schema0"
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "environment_failure"
      ]
    },
    "measurements": {},
    "score": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "openneko.eval.score/v1"
        },
        "scorerId": {
          "$ref": "#/$defs/__schema0"
        },
        "scorerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "scorerDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "vector": {
          "type": "object",
          "properties": {
            "groundTruth": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "method": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "behavior": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "safety": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "efficiency": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "groundTruth",
            "method",
            "behavior",
            "safety",
            "efficiency"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "properties": {
            "groundTruth": {
              "type": "boolean"
            },
            "method": {
              "type": "boolean"
            },
            "behavior": {
              "type": "boolean"
            },
            "safety": {
              "type": "boolean"
            },
            "efficiency": {
              "type": "boolean"
            }
          },
          "required": [
            "groundTruth",
            "method",
            "behavior",
            "safety",
            "efficiency"
          ],
          "additionalProperties": false
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "assertionId": {
                "$ref": "#/$defs/__schema0"
              },
              "dimension": {
                "type": "string",
                "enum": [
                  "ground_truth",
                  "method",
                  "behavior",
                  "safety",
                  "efficiency"
                ]
              },
              "passed": {
                "type": "boolean"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "gate": {
                "type": "boolean"
              },
              "diagnostic": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "required": [
              "assertionId",
              "dimension",
              "passed",
              "score",
              "gate"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "scorerId",
        "scorerVersion",
        "scorerDigest",
        "verdict",
        "vector",
        "coverage",
        "checks"
      ],
      "additionalProperties": false
    },
    "errorType": {
      "type": "string",
      "maxLength": 128
    },
    "error": {
      "type": "string",
      "maxLength": 2048
    },
    "episodeDigest": {
      "type": "string",
      "pattern": "^sha256:.*"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "slotKey",
    "caseId",
    "caseContentId",
    "family",
    "productPath",
    "difficulty",
    "capabilityTags",
    "semantics",
    "variantId",
    "datasetId",
    "repetition",
    "phase",
    "attempt",
    "startedAt",
    "finishedAt",
    "status",
    "measurements",
    "episodeDigest"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    }
  }
}
