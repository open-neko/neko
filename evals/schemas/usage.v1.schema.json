{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "openneko.eval.usage/v1"
    },
    "scope": {
      "type": "string",
      "enum": [
        "outer",
        "inner",
        "total"
      ]
    },
    "inputTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "outputTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cacheReadTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cacheWriteTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reasoningTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "totalTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "estimatedCostUsd": {
      "type": "number",
      "minimum": 0
    },
    "billedCostUsd": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "pricingCatalogVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "coverage": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ]
    },
    "missingReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      }
    }
  },
  "required": [
    "schemaVersion",
    "scope",
    "coverage"
  ],
  "additionalProperties": false
}
