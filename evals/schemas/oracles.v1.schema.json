{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "openneko.eval.oracles/v1"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:.*"
    },
    "values": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schemaVersion",
    "digest",
    "values"
  ],
  "additionalProperties": false
}
