{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "openneko.eval.generator/v1"
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "dataset": {
      "$ref": "#/$defs/__schema0"
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "count": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "quotas": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "settings": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "dataset",
    "seed",
    "count",
    "quotas",
    "settings"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "capability": {
          "$ref": "#/$defs/__schema0"
        },
        "difficulty": {
          "$ref": "#/$defs/__schema0"
        },
        "minimum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximum": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "capability",
        "minimum",
        "maximum"
      ],
      "additionalProperties": false
    }
  }
}
