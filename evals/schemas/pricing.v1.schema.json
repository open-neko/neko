{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "openneko.eval.pricing/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "currency": {
      "type": "string",
      "const": "USD"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "entries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "currency",
    "effective_date",
    "sources",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uri"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "input_usd_per_million_tokens": {
          "type": "number",
          "minimum": 0
        },
        "output_usd_per_million_tokens": {
          "type": "number",
          "minimum": 0
        },
        "cache_read_usd_per_million_tokens": {
          "type": "number",
          "minimum": 0
        },
        "cache_write_usd_per_million_tokens": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": [
        "provider",
        "model",
        "input_usd_per_million_tokens",
        "output_usd_per_million_tokens"
      ],
      "additionalProperties": false
    }
  }
}
