{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "openneko.eval.dataset/v1"
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "snapshots": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "connection": {
      "type": "object",
      "properties": {
        "agent_graphql_ref": {
          "$ref": "#/$defs/__schema2"
        },
        "agent_mcp_ref": {
          "$ref": "#/$defs/__schema2"
        },
        "oracle_database_ref": {
          "$ref": "#/$defs/__schema2"
        },
        "defaults": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "anchor_policy": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "fixed",
            "data-derived"
          ]
        },
        "value": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "license",
    "capabilities",
    "snapshots",
    "connection",
    "anchor_policy"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "description": {
          "type": "string"
        },
        "seed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "pattern": "^env:[A-Z][A-Z0-9_]*$"
    }
  }
}
