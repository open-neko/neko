{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "openneko.eval.manifest/v1"
    },
    "runnerVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "runId": {
      "$ref": "#/$defs/__schema0"
    },
    "configId": {
      "$ref": "#/$defs/__schema0"
    },
    "suiteId": {
      "$ref": "#/$defs/__schema0"
    },
    "attestation": {
      "type": "string",
      "enum": [
        "self-reported",
        "ci-attested"
      ]
    },
    "suiteGates": {
      "default": {
        "require_safety": true
      },
      "type": "object",
      "properties": {
        "min_macro_ground_truth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_method": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_behavior": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_full_task_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_token_usage_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_capability_task_pass_rate": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema0"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "max_unsafe_effects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "require_safety": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "require_safety"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "complete"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "source": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "commit",
        "dirty"
      ],
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "configDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "suiteDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "datasetDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "oracleDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "scorerDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "variantDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:.*"
        }
      },
      "required": [
        "configDigest",
        "suiteDigest",
        "datasetDigest",
        "oracleDigest",
        "scorerDigest",
        "variantDigest",
        "sourceDigest"
      ],
      "additionalProperties": false
    },
    "datasetFingerprint": {},
    "resolvedVariants": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "effectiveConfig": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "openneko.eval/v1"
        },
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "description": {
          "type": "string",
          "maxLength": 2048
        },
        "adapter": {
          "$ref": "#/$defs/__schema0"
        },
        "semantics": {
          "$ref": "#/$defs/__schema1"
        },
        "pricing": {
          "$ref": "#/$defs/__schema1"
        },
        "suite": {
          "type": "object",
          "properties": {
            "ref": {
              "$ref": "#/$defs/__schema2"
            },
            "cases": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "ref"
          ],
          "additionalProperties": false
        },
        "datasets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        },
        "defaults": {
          "default": {
            "repetitions": 1,
            "timeout": "10m",
            "execution_order": "counterbalanced",
            "concurrency": 1,
            "cache_state": "warm",
            "content_capture": "metadata",
            "max_attempts": 2
          },
          "type": "object",
          "properties": {
            "repetitions": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "timeout": {
              "default": "10m",
              "$ref": "#/$defs/__schema4"
            },
            "execution_order": {
              "default": "counterbalanced",
              "type": "string",
              "enum": [
                "declared",
                "randomized",
                "counterbalanced"
              ]
            },
            "concurrency": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "cache_state": {
              "default": "warm",
              "type": "string",
              "enum": [
                "cold",
                "warm",
                "mixed"
              ]
            },
            "content_capture": {
              "default": "metadata",
              "type": "string",
              "enum": [
                "off",
                "metadata",
                "redacted"
              ]
            },
            "max_attempts": {
              "default": 2,
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          },
          "required": [
            "repetitions",
            "timeout",
            "execution_order",
            "concurrency",
            "cache_state",
            "content_capture",
            "max_attempts"
          ],
          "additionalProperties": false
        },
        "variants": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        },
        "budgets": {
          "type": "object",
          "properties": {
            "max_wall_time": {
              "$ref": "#/$defs/__schema4"
            },
            "max_estimated_cost_usd": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "artifacts": {
          "default": {
            "check_in": "scored",
            "raw_dir": ".openneko/evals/raw",
            "state_dir": ".openneko/evals/state",
            "results_dir": "evals/results"
          },
          "type": "object",
          "properties": {
            "check_in": {
              "default": "scored",
              "type": "string",
              "enum": [
                "none",
                "scored"
              ]
            },
            "raw_dir": {
              "default": ".openneko/evals/raw",
              "type": "string",
              "minLength": 1
            },
            "state_dir": {
              "default": ".openneko/evals/state",
              "type": "string",
              "minLength": 1
            },
            "results_dir": {
              "default": "evals/results",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "check_in",
            "raw_dir",
            "state_dir",
            "results_dir"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "id",
        "adapter",
        "suite",
        "datasets",
        "defaults",
        "variants",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "plannedSlotKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expectedSlotKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completedSlotKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failedSlotKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inFlightSlotKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resultDir": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "runnerVersion",
    "runId",
    "configId",
    "suiteId",
    "attestation",
    "suiteGates",
    "status",
    "createdAt",
    "updatedAt",
    "source",
    "compatibility",
    "resolvedVariants",
    "effectiveConfig",
    "expectedSlotKeys",
    "completedSlotKeys",
    "failedSlotKeys",
    "inFlightSlotKeys"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "minLength": 1
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/__schema2"
        },
        "snapshot": {
          "$ref": "#/$defs/__schema0"
        },
        "settings": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "ref",
        "snapshot"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "string",
      "pattern": "^\\d+(?:ms|s|m|h)$"
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "extends": {
          "$ref": "#/$defs/__schema0"
        },
        "backend": {
          "$ref": "#/$defs/__schema0"
        },
        "outer_model": {
          "$ref": "#/$defs/__schema6"
        },
        "data_path": {
          "type": "string",
          "enum": [
            "graphjin-direct",
            "graphjin-agent",
            "planner-host-execute",
            "none"
          ]
        },
        "inner_model": {
          "$ref": "#/$defs/__schema6"
        },
        "settings": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "backend",
        "outer_model",
        "data_path"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "credential_ref": {
          "type": "string",
          "pattern": "^env:[A-Z][A-Z0-9_]*$"
        },
        "config": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "additionalProperties": false
    }
  }
}
