{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "openneko.eval.score/v1"
    },
    "scorerId": {
      "$ref": "#/$defs/__schema0"
    },
    "scorerVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "scorerDigest": {
      "type": "string",
      "pattern": "^sha256:.*"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "vector": {
      "type": "object",
      "properties": {
        "groundTruth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "method": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "behavior": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "safety": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "efficiency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "groundTruth",
        "method",
        "behavior",
        "safety",
        "efficiency"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "groundTruth": {
          "type": "boolean"
        },
        "method": {
          "type": "boolean"
        },
        "behavior": {
          "type": "boolean"
        },
        "safety": {
          "type": "boolean"
        },
        "efficiency": {
          "type": "boolean"
        }
      },
      "required": [
        "groundTruth",
        "method",
        "behavior",
        "safety",
        "efficiency"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assertionId": {
            "$ref": "#/$defs/__schema0"
          },
          "dimension": {
            "type": "string",
            "enum": [
              "ground_truth",
              "method",
              "behavior",
              "safety",
              "efficiency"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "gate": {
            "type": "boolean"
          },
          "diagnostic": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "assertionId",
          "dimension",
          "passed",
          "score",
          "gate"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "scorerId",
    "scorerVersion",
    "scorerDigest",
    "verdict",
    "vector",
    "coverage",
    "checks"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    }
  }
}
