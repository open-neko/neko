{
  "schema_version": 1,
  "id": "crm",
  "version": "1.0.0",
  "description": "A relationship-led CRM for accounts, contacts, opportunities, and customer activity.",
  "definition": {
    "app": "crm",
    "label": "CRM",
    "purpose": "Manage customer relationships, pipeline, and follow-up without embedding CRM-specific behavior in the records engine.",
    "nav_order": 20,
    "objects": [
      {
        "api_name": "account",
        "label": "Account",
        "plural_label": "Accounts",
        "name_field": "name",
        "visibility": "org",
        "fields": [
          { "api_name": "name", "label": "Account name", "kind": "text", "required": true, "length": 200 },
          { "api_name": "industry", "label": "Industry", "kind": "picklist", "picklist_values": ["technology", "financial_services", "healthcare", "manufacturing", "retail", "professional_services", "other"] },
          { "api_name": "website", "label": "Website", "kind": "url" },
          { "api_name": "phone", "label": "Phone", "kind": "phone" },
          { "api_name": "billing_city", "label": "Billing city", "kind": "text", "length": 120 }
        ],
        "layouts": [
          { "kind": "list", "definition": { "columns": ["name", "industry", "billing_city", "phone"] } },
          { "kind": "detail", "definition": { "sections": [{ "label": "Account", "fields": ["name", "industry", "website", "phone", "billing_city"] }] } }
        ]
      },
      {
        "api_name": "contact",
        "label": "Contact",
        "plural_label": "Contacts",
        "name_field": "full_name",
        "visibility": "owner",
        "fields": [
          { "api_name": "full_name", "label": "Full name", "kind": "text", "required": true, "length": 200 },
          { "api_name": "account", "label": "Account", "kind": "reference", "reference_targets": ["account"] },
          { "api_name": "email", "label": "Email", "kind": "email" },
          { "api_name": "phone", "label": "Phone", "kind": "phone" },
          { "api_name": "title", "label": "Title", "kind": "text", "length": 160 }
        ],
        "layouts": [
          { "kind": "list", "definition": { "columns": ["full_name", "account", "email", "title"] } },
          { "kind": "detail", "definition": { "sections": [{ "label": "Contact", "fields": ["full_name", "account", "title"] }, { "label": "Contact details", "fields": ["email", "phone"] }] } }
        ]
      },
      {
        "api_name": "opportunity",
        "label": "Opportunity",
        "plural_label": "Opportunities",
        "name_field": "name",
        "visibility": "owner",
        "fields": [
          { "api_name": "name", "label": "Opportunity name", "kind": "text", "required": true, "length": 200 },
          { "api_name": "account", "label": "Account", "kind": "reference", "reference_targets": ["account"], "required": true },
          { "api_name": "stage", "label": "Stage", "kind": "picklist", "required": true, "picklist_values": ["qualification", "discovery", "proposal", "negotiation", "closed_won", "closed_lost"] },
          { "api_name": "amount", "label": "Amount", "kind": "currency", "scale": 2 },
          { "api_name": "close_date", "label": "Close date", "kind": "date", "required": true },
          { "api_name": "probability", "label": "Probability", "kind": "percent", "scale": 2 }
        ],
        "layouts": [
          { "kind": "list", "definition": { "columns": ["name", "account", "stage", "amount", "close_date"] } },
          { "kind": "detail", "definition": { "sections": [{ "label": "Opportunity", "fields": ["name", "account", "stage"] }, { "label": "Commercial", "fields": ["amount", "probability", "close_date"] }] } }
        ]
      },
      {
        "api_name": "activity",
        "label": "Activity",
        "plural_label": "Activities",
        "name_field": "subject",
        "visibility": "owner",
        "fields": [
          { "api_name": "subject", "label": "Subject", "kind": "text", "required": true, "length": 240 },
          { "api_name": "activity_type", "label": "Type", "kind": "picklist", "required": true, "picklist_values": ["call", "email", "meeting", "note", "task"] },
          { "api_name": "opportunity", "label": "Opportunity", "kind": "reference", "reference_targets": ["opportunity"] },
          { "api_name": "contact", "label": "Contact", "kind": "reference", "reference_targets": ["contact"] },
          { "api_name": "occurred_at", "label": "Occurred at", "kind": "datetime", "required": true },
          { "api_name": "notes", "label": "Notes", "kind": "textarea" }
        ],
        "layouts": [
          { "kind": "list", "definition": { "columns": ["subject", "activity_type", "opportunity", "contact", "occurred_at"] } },
          { "kind": "detail", "definition": { "sections": [{ "label": "Activity", "fields": ["subject", "activity_type", "occurred_at"] }, { "label": "Related records", "fields": ["opportunity", "contact"] }, { "label": "Notes", "fields": ["notes"] }] } }
        ]
      }
    ],
    "permissions": [
      { "role": "admin", "object": "account", "read": true, "create": true, "update": true, "delete": true },
      { "role": "member", "object": "account", "read": true, "create": true, "update": true, "delete": false },
      { "role": "admin", "object": "contact", "read": true, "create": true, "update": true, "delete": true },
      { "role": "member", "object": "contact", "read": true, "create": true, "update": true, "delete": false },
      { "role": "admin", "object": "opportunity", "read": true, "create": true, "update": true, "delete": true },
      { "role": "member", "object": "opportunity", "read": true, "create": true, "update": true, "delete": false },
      { "role": "admin", "object": "activity", "read": true, "create": true, "update": true, "delete": true },
      { "role": "member", "object": "activity", "read": true, "create": true, "update": true, "delete": false }
    ],
    "pages": [
      {
        "api_name": "overview",
        "label": "Overview",
        "nav_order": 0,
        "definition": {
          "blocks": [
            { "label": "Open pipeline", "query": { "object": "opportunity", "aggregate": "sum", "field": "amount", "where": { "stage": { "not_in": ["closed_won", "closed_lost"] } } }, "renderer": "metric", "span": 1 },
            { "label": "Closing soon", "query": { "object": "opportunity", "view": "closing_this_month", "limit": 8 }, "renderer": "list", "span": 2 },
            { "label": "Recent activity", "query": { "object": "activity", "sort": [{ "field": "occurred_at", "direction": "desc" }], "limit": 12 }, "renderer": "timeline", "span": 3 }
          ]
        }
      }
    ]
  }
}
