{
  "schema_version": 1,
  "id": "support",
  "version": "1.0.0",
  "description": "A support desk for organizations, requesters, tickets, and their conversation history.",
  "definition": {
    "app": "support",
    "label": "Support",
    "purpose": "Triage customer requests, coordinate ownership, and preserve the full support conversation.",
    "nav_order": 30,
    "objects": [
      {
        "api_name": "organization",
        "label": "Organization",
        "plural_label": "Organizations",
        "name_field": "name",
        "visibility": "org",
        "fields": [
          { "api_name": "name", "label": "Organization name", "kind": "text", "required": true, "length": 200 },
          { "api_name": "tier", "label": "Support tier", "kind": "picklist", "picklist_values": ["standard", "priority", "strategic"] },
          { "api_name": "domain", "label": "Domain", "kind": "text", "length": 200 }
        ],
        "layouts": [
          { "kind": "list", "definition": { "columns": ["name", "tier", "domain"] } },
          { "kind": "detail", "definition": { "sections": [{ "label": "Organization", "fields": ["name", "tier", "domain"] }] } }
        ]
      },
      {
        "api_name": "requester",
        "label": "Requester",
        "plural_label": "Requesters",
        "name_field": "full_name",
        "visibility": "org",
        "fields": [
          { "api_name": "full_name", "label": "Full name", "kind": "text", "required": true, "length": 200 },
          { "api_name": "organization", "label": "Organization", "kind": "reference", "reference_targets": ["organization"] },
          { "api_name": "email", "label": "Email", "kind": "email", "required": true },
          { "api_name": "phone", "label": "Phone", "kind": "phone" }
        ],
        "layouts": [
          { "kind": "list", "definition": { "columns": ["full_name", "organization", "email", "phone"] } },
          { "kind": "detail", "definition": { "sections": [{ "label": "Requester", "fields": ["full_name", "organization", "email", "phone"] }] } }
        ]
      },
      {
        "api_name": "ticket",
        "label": "Ticket",
        "plural_label": "Tickets",
        "name_field": "subject",
        "visibility": "owner",
        "fields": [
          { "api_name": "subject", "label": "Subject", "kind": "text", "required": true, "length": 240 },
          { "api_name": "description", "label": "Description", "kind": "textarea" },
          { "api_name": "organization", "label": "Organization", "kind": "reference", "reference_targets": ["organization"] },
          { "api_name": "requester", "label": "Requester", "kind": "reference", "reference_targets": ["requester"], "required": true },
          { "api_name": "status", "label": "Status", "kind": "picklist", "required": true, "picklist_values": ["new", "open", "pending", "solved", "closed"] },
          { "api_name": "priority", "label": "Priority", "kind": "picklist", "required": true, "picklist_values": ["low", "normal", "high", "urgent"] },
          { "api_name": "channel", "label": "Channel", "kind": "picklist", "picklist_values": ["email", "web", "chat", "phone", "api"] },
          { "api_name": "opened_at", "label": "Opened at", "kind": "datetime", "required": true },
          { "api_name": "due_at", "label": "Due at", "kind": "datetime" },
          { "api_name": "resolved_at", "label": "Resolved at", "kind": "datetime" }
        ],
        "layouts": [
          { "kind": "list", "definition": { "columns": ["subject", "status", "priority", "requester", "organization", "due_at"] } },
          { "kind": "detail", "definition": { "sections": [{ "label": "Ticket", "fields": ["subject", "description", "status", "priority"] }, { "label": "Customer", "fields": ["organization", "requester", "channel"] }, { "label": "Timing", "fields": ["opened_at", "due_at", "resolved_at"] }] } }
        ]
      },
      {
        "api_name": "ticket_comment",
        "label": "Ticket comment",
        "plural_label": "Ticket comments",
        "name_field": "body",
        "visibility": "org",
        "fields": [
          { "api_name": "body", "label": "Comment", "kind": "textarea", "required": true },
          { "api_name": "ticket", "label": "Ticket", "kind": "reference", "reference_targets": ["ticket"], "required": true },
          { "api_name": "public", "label": "Public reply", "kind": "boolean" },
          { "api_name": "posted_at", "label": "Posted at", "kind": "datetime", "required": true }
        ],
        "layouts": [
          { "kind": "list", "definition": { "columns": ["ticket", "body", "public", "posted_at"] } },
          { "kind": "detail", "definition": { "sections": [{ "label": "Comment", "fields": ["ticket", "body", "public", "posted_at"] }] } }
        ]
      }
    ],
    "permissions": [
      { "role": "admin", "object": "organization", "read": true, "create": true, "update": true, "delete": true },
      { "role": "member", "object": "organization", "read": true, "create": false, "update": false, "delete": false },
      { "role": "admin", "object": "requester", "read": true, "create": true, "update": true, "delete": true },
      { "role": "member", "object": "requester", "read": true, "create": true, "update": true, "delete": false },
      { "role": "admin", "object": "ticket", "read": true, "create": true, "update": true, "delete": true },
      { "role": "member", "object": "ticket", "read": true, "create": true, "update": true, "delete": false },
      { "role": "admin", "object": "ticket_comment", "read": true, "create": true, "update": true, "delete": true },
      { "role": "member", "object": "ticket_comment", "read": true, "create": true, "update": true, "delete": false }
    ],
    "pages": [
      {
        "api_name": "overview",
        "label": "Overview",
        "nav_order": 0,
        "definition": {
          "blocks": [
            { "label": "Open tickets", "query": { "object": "ticket", "aggregate": "count", "where": { "status": { "in": ["new", "open", "pending"] } } }, "renderer": "metric", "span": 1 },
            { "label": "Urgent queue", "query": { "object": "ticket", "where": { "priority": { "eq": "urgent" }, "status": { "in": ["new", "open", "pending"] } }, "sort": [{ "field": "opened_at", "direction": "asc" }], "limit": 8 }, "renderer": "list", "span": 2 },
            { "label": "Recent updates", "query": { "object": "ticket_comment", "sort": [{ "field": "posted_at", "direction": "desc" }], "limit": 12 }, "renderer": "timeline", "span": 3 }
          ]
        }
      }
    ]
  }
}
