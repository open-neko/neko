  "findings": [],
  "live": {
    "endpoint": "http://localhost:8080/api/v1/graphql",
    "pollMs": 5000,
    "bindings": [
      {"root": "salesterritory", "matchPrefix": "t-", "rowKey": "name",
       "query": "query { salesterritory { name salesytd } }",
       "size": {"field": "salesytd", "max": 11600000},
       "stat": {"label": "Sales YTD", "field": "salesytd", "format": "$M"},
       "weightField": "salesytd"},
      {"root": "salesorderheader", "field": "count_salesorderid",
       "query": "query { salesorderheader(where:{orderdate:{gt:\"{{daysAgo:1}}\"}}) { count_salesorderid } }",
       "kpi": 0},
      {"root": "salesorderheader", "field": "sum_subtotal",
       "query": "query { salesorderheader(where:{orderdate:{gt:\"{{daysAgo:30}}\"}}) { sum_subtotal } }",
       "kpi": 1, "format": "$M"},
      {"root": "salesorderheader", "field": "count_salesorderid",
       "query": "query { salesorderheader(where:{and:[{status:{eq:1}},{shipdate:{is_null:true}}]}) { count_salesorderid } }",
       "target": "dock", "stat": {"label": "Pending", "format": "int"}, "kpi": 2},
      {"root": "salesorderheader", "field": "count_salesorderid",
       "query": "query { salesorderheader(where:{and:[{status:{eq:1}},{shipdate:{is_null:true}},{orderdate:{lt:\"{{daysAgo:5}}\"}}]}) { count_salesorderid } }",
       "target": "dock", "stat": {"label": "Breaching SLA", "format": "int"}, "kpi": 3,
       "finding": {"id": "slowship", "severity": "amber", "target": "dock",
         "titleTpl": "{n} orders pending > 5 days",
         "source": "Slow-Ship watcher · live · 5s",
         "action": "Draft carrier follow-up and post the stuck-order list to #ops.",
         "cluster": true}},
      {"root": "salesorderheader", "field": "count_salesorderid",
       "query": "query { salesorderheader(where:{shipdate:{gt:\"{{daysAgo:1}}\"}}) { count_salesorderid } }",
       "target": "dock", "stat": {"label": "Shipped 24h", "format": "int"}},
      {"root": "purchaseorderheader", "field": "count_purchaseorderid",
       "query": "query { purchaseorderheader(where:{status:{in:[1,2]}}) { count_purchaseorderid } }",
       "target": "vend", "stat": {"label": "Open POs", "format": "int"}},
      {"root": "productinventory", "field": "sum_quantity",
       "query": "query { productinventory(where:{product:{name:{eq:\"Mountain-200 Black, 38\"}}}) { sum_quantity } }",
       "target": "s-m200", "stat": {"label": "On hand", "format": "int"},
       "finding": {"id": "low-m200", "severity": "red", "target": "s-m200", "below": 75,
         "titleTpl": "Mountain-200 below reorder point ({n} < 75)",
         "source": "Reorder watcher · live · 5s",
         "action": "Draft purchase order to the frame vendor."}},
      {"root": "productinventory", "field": "sum_quantity",
       "query": "query { productinventory(where:{product:{name:{eq:\"Road-150 Red, 62\"}}}) { sum_quantity } }",
       "target": "s-r150", "stat": {"label": "On hand", "format": "int"},
       "finding": {"id": "low-r150", "severity": "red", "target": "s-r150", "below": 75,
         "titleTpl": "Road-150 below reorder point ({n} < 75)",
         "source": "Reorder watcher · live · 5s",
         "action": "Draft purchase order to Vision Cycles, Inc."}},
      {"root": "productinventory", "field": "sum_quantity",
       "query": "query { productinventory(where:{product:{name:{eq:\"Touring-1000 Blue, 50\"}}}) { sum_quantity } }",
       "target": "s-t1000", "stat": {"label": "On hand", "format": "int"},
       "finding": {"id": "low-t1000", "severity": "red", "target": "s-t1000", "below": 75,
         "titleTpl": "Touring-1000 below reorder point ({n} < 75)",
         "source": "Reorder watcher · live · 5s",
         "action": "Draft purchase order to the touring-frame vendor."}}
    ]
  }
